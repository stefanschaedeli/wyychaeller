# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Must support the web_search_20260209 tool (Opus 5, Sonnet 5, Opus/Sonnet 4.6+).
CLAUDE_MODEL=claude-sonnet-5
# Only needed for WINE_INTELLIGENCE_MODE=gemini. Use a paid-tier key from Google AI Studio.
GEMINI_API_KEY=
# Must support Google Search grounding and structured output.
GEMINI_MODEL=gemini-3.7-flash
# "claude" or "gemini" call the real API of that provider (gemini costs far less per wine).
# "recorded" returns canned answers (tests, demos, no cost).
WINE_INTELLIGENCE_MODE=claude
# How much the container log shows: debug, info (default), warn, error or silent.
LOG_LEVEL=info
# Host port of the local deploy (docker-compose.yml maps it to the container's port 3000).
WEINKELLER_PORT=3010
